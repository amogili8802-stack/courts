rules_version = '2';

// Access control for the LAGCC court schedule.
//
// Everything is closed unless the caller is signed in with a verified phone
// number that has a document in `lagcc_allowed`. That collection IS the access
// list. The document ID is the number in E.164 form, and a `name` field gives
// the person the label their edits appear under:
//
//   Document ID:  +15551234567
//   Field:        name (string)  e.g. "Anjali"
//
//   Add a coach:     create that document
//   Remove a coach:  delete it (they lose access on their next page load)
//   Rename someone:  edit the name field
//
// Because only an admin can set `name` here, nobody can relabel their own
// edits in the history.
//
// Phone numbers are deliberately kept out of this repository. Manage the list
// in the Firebase console: Firestore Database -> Data -> lagcc_allowed.
//
// To apply: Firebase console -> Firestore Database -> Rules -> paste -> Publish.
// (Add your own number to lagcc_allowed BEFORE publishing, or you'll lock
// yourself out of the app — the console itself always keeps working.)

service cloud.firestore {
  match /databases/{database}/documents {

    function callerPhone() {
      return request.auth != null ? request.auth.token.phone_number : "";
    }

    function isAllowed() {
      return request.auth != null
        && callerPhone() != null
        && callerPhone() != ""
        && exists(/databases/$(database)/documents/lagcc_allowed/$(callerPhone()));
    }

    // Signed-in people may read their own entry — that's how the app gets the
    // name to label their edits with, and how it can say "you're not on the
    // access list" instead of failing silently. Nobody can read anyone else's
    // entry, list the collection, or write to it from the app.
    match /lagcc_allowed/{phone} {
      allow get: if request.auth != null && callerPhone() == phone;
      allow list, write: if false;
    }

    match /lagcc_schedules/{date} {
      allow read, write: if isAllowed();
    }

    match /lagcc_recurring/{ruleId} {
      allow read, write: if isAllowed();
    }

    // Anything not named above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
