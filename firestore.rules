rules_version = '2';

// Access control for the LAGCC court schedule.
//
// Everything is closed unless the caller is signed in with a Google account
// whose email has a document in `lagcc_allowed`. That collection IS the access
// list: the document ID is the person's lowercased email, and the contents
// don't matter (an empty document is fine).
//
//   Add a coach:     create lagcc_allowed/<their.email@example.com>
//   Remove a coach:  delete that document
//
// Deliberately kept out of this file so the repository never carries staff
// email addresses. Manage it in the Firebase console:
// Firestore Database -> Data -> lagcc_allowed.
//
// To apply: Firebase console -> Firestore Database -> Rules -> paste -> Publish.
// (Add yourself to lagcc_allowed BEFORE publishing, or you'll lock yourself out
// of the app — the console itself always keeps working.)

service cloud.firestore {
  match /databases/{database}/documents {

    function callerEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : "";
    }

    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/lagcc_allowed/$(callerEmail()));
    }

    // Signed-in people may check whether their own address is on the list, so
    // the app can say "you're not on the access list" instead of failing
    // silently. Nobody can read anyone else's entry or edit the list from the
    // app — it's console-only.
    match /lagcc_allowed/{email} {
      allow get: if request.auth != null && callerEmail() == email;
      allow list, write: if false;
    }

    match /lagcc_schedules/{date} {
      allow read, write: if isAllowed();
    }

    match /lagcc_recurring/{ruleId} {
      allow read, write: if isAllowed();
    }

    // Anything not named above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
